# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # public; RLS enforces access
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SERVER ONLY — never expose

# ── Paystack (blueprint §18.1) ──────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...                 # SERVER ONLY
# Currencies the merchant account may CHARGE in (Paystack has no GBP/EUR).
PAYSTACK_ENABLED_CURRENCIES=NGN,USD

# ── FX (display conversion; server-fetched, never trusted from browser) ────
FX_PROVIDER_BASE_URL=https://open.er-api.com/v6
FX_PROVIDER_API_KEY=
FX_PROVIDER_BASE_CURRENCY=NGN
FX_CACHE_TTL_SECONDS=300
FX_MAX_AGE_SECONDS=3600
# Deterministic fallback + CI mode: "USD=0.00065;GBP=0.00051;EUR=0.00060"
MANUAL_FX_RATES=

# ── App ────────────────────────────────────────────────────────────────────
# Public origin; drives canonical/OG metadataBase. Local Windows dev keeps it as-is.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Bearer secret for /api/jobs/maintenance (cron: expiry + purge + archive)
CRON_SECRET=change-me
# Quote TTL seconds (60..900, clamped in DB)
CHECKOUT_QUOTE_TTL_SECONDS=600

# ── Offline UI testing (optional) ──────────────────────────────────────
# DEMO_FALLBACK=1 keeps the static demo-catalog fallback active even in
# production builds (staging smoke tests). In dev it activates automatically
# whenever Supabase is unreachable. Payments NEVER run on demo data: quote
# math comes from the seeded catalog mirror, checkout-to-Paystack is refused
# with 503, and every demo response carries "demo": true.
# DEMO_FALLBACK=1

# ── Production deploy notes (Netlify) ───────────────────────────────────
# Netlify env vars are set per-environment via `npx netlify env:set <KEY> <VALUE>`
# (or UI → Site configuration → Environment variables); this file stays the
# local-dev template only — never commit a filled copy.
#
# Deployment-specific values:
#  • NEXT_PUBLIC_APP_URL = https://<your-netlify-domain>  (drives metadataBase
#    and canonical URLs; NEXT_PUBLIC_* is baked at BUILD time, so set it
#    BEFORE the first `--build` deploy and rebuild after any change).
#  • Also allow-list that origin in Supabase → Authentication → URL
#    Configuration (Site URL + Redirect URLs: https://<domain>/**) or
#    email-confirm / OAuth callbacks will 422.
#  • Paystack → Settings → API Keys & Webhooks: point the webhook at
#    https://<domain>/api/webhooks/paystack (HMAC-verified; the middleware
#    explicitly exempts this route from auth/redirect).
#  • Server-only keys (SUPABASE_SERVICE_ROLE_KEY, PAYSTACK_SECRET_KEY,
#    CRON_SECRET, FX_PROVIDER_API_KEY) must NOT carry the NEXT_PUBLIC_
#    prefix and must never appear in any client bundle.
#  • DEMO_FALLBACK: leave unset in production.
#  • NODE_VERSION is pinned in netlify.toml (build.environment), not here.

# ── Auth surface ───────────────────────────────────────────────────────────
# "Continue with Google" button on /login + /signup. It stays hidden unless
# "true" — baked at build (NEXT_PUBLIC_). Flip it on only after Supabase →
# Authentication → Providers → Google is enabled with a real OAuth client
# (see docs/ADMIN_CATALOG_STORAGE.md § Google OAuth). Email + password
# remains the default flow either way.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
